<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:GTPatcher.ViewModels"
        xmlns:types="using:GTPatcher.Types"
        mc:Ignorable="d"
        Title="Gorilla Tag Patcher Launcher"
        Width="900" Height="600"
        CanResize="False"
        x:Class="GTPatcher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Background="#1e1e1e">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.DataTemplates>
        <DataTemplate DataType="vm:YearHeader">
            <Border Background="#333333" Padding="10,5" Margin="0,10,0,5">
                <TextBlock Text="{Binding Year}" FontWeight="Bold" Foreground="#aa39ff"/>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="vm:PatchEntry">
            <Border Padding="15,5">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Patch.PatchName}" FontSize="13"/>
                        <TextBlock Text="{Binding Patch.Date}" FontSize="11" Foreground="#888888"/>
                    </StackPanel>
                    <Ellipse Grid.Column="1" Width="8" Height="8" Fill="#4caf50"
                             IsVisible="{Binding IsDownloaded}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.DataTemplates>

	<Grid RowDefinitions="Auto, *">
        <!-- Header -->
        <Border Grid.Row="0" Background="#252525" Padding="15" BorderBrush="#333333" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="20">
                <TextBlock Text="GTPatcher" FontSize="20" FontWeight="Bold" Foreground="#aa39ff"/>
                <TabStrip x:Name="MainTabStrip" Background="Transparent" SelectedIndex="{Binding SelectedTabIndex}">
                    <TabStripItem Content="Installations" />
                    <TabStripItem Content="Settings" />
                    <TabStripItem Content="Info" />
                </TabStrip>
            </StackPanel>
        </Border>

        <!-- Content -->
        <Carousel Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">
            <!-- Installations Tab Content -->
            <Grid ColumnDefinitions="300, *">
                <!-- Build List Sidebar -->
                <Border Grid.Column="0" Background="#252525" BorderBrush="#333333" BorderThickness="0,0,1,0">
                    <ListBox ItemsSource="{Binding BuildEntries}"
                             SelectedItem="{Binding SelectedEntry}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </ListBox.Styles>
                    </ListBox>
                </Border>

                <!-- Build Details -->
                <Grid Grid.Column="1" RowDefinitions="*, Auto" Margin="20">
                    <StackPanel Spacing="15" IsVisible="{Binding SelectedPatch, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="{Binding SelectedPatch.PatchName}" FontSize="24" FontWeight="Bold" Foreground="#ffffff"/>

                        <Border Background="#333333" CornerRadius="5" Padding="10">
                            <StackPanel Spacing="5">
                                <TextBlock Text="Description" FontWeight="SemiBold" Foreground="#aaaaaa" FontSize="12"/>
                                <TextBlock Text="{Binding SelectedPatch.PatchDescription}" TextWrapping="Wrap" FontSize="14"/>
                            </StackPanel>
                        </Border>

                        <Grid ColumnDefinitions="Auto, *">
                            <StackPanel Grid.Column="0" Spacing="10" Width="150">
                                <TextBlock Text="Year" FontWeight="SemiBold" Foreground="#aaaaaa" FontSize="12"/>
                                <TextBlock Text="{Binding SelectedPatch.Year}" FontSize="14"/>

                                <TextBlock Text="Branch" FontWeight="SemiBold" Foreground="#aaaaaa" FontSize="12" Margin="0,10,0,0"/>
                                <TextBlock Text="{Binding SelectedPatch.Branch}" FontSize="14"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="10">
                                <TextBlock Text="Manifest ID" FontWeight="SemiBold" Foreground="#aaaaaa" FontSize="12"/>
                                <TextBlock Text="{Binding SelectedPatch.ManifestId}" FontSize="14"/>

                                <TextBlock Text="Status" FontWeight="SemiBold" Foreground="#aaaaaa" FontSize="12" Margin="0,10,0,0"/>
                                <TextBlock Text="{Binding StatusText}" FontSize="14" Foreground="#aa39ff"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <TextBlock IsVisible="{Binding SelectedPatch, Converter={x:Static ObjectConverters.IsNull}}"
                               Text="Select a build from the list to see details"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="#888888"/>

                    <!-- Play Button -->
                    <Button Grid.Row="1"
                            Content="Play!"
                            HorizontalAlignment="Right"
                            Width="120" Height="40"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            FontSize="16" FontWeight="Bold"
                            Click="PlayButton"
                            Background="#aa39ff"
                            Foreground="White"
                            IsVisible="{Binding SelectedPatch, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </Grid>
            </Grid>

            <!-- Settings Tab Content -->
            <ScrollViewer>
                <StackPanel Margin="40" Spacing="25" MaxWidth="600" HorizontalAlignment="Left">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Steam Account Username" FontSize="16" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding SteamUsername, Mode=TwoWay}" Watermark="Enter Steam username"/>
                        <TextBlock Text="You will be asked for your account password (and Steam Guard) when downloading."
                                   FontSize="12" Foreground="#888888"/>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Installation Path" FontSize="16" FontWeight="SemiBold"/>
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBox Grid.Column="0" Text="{Binding InstallationPath, Mode=TwoWay}" Watermark="Select folder..."/>
                            <Button Grid.Column="1" Content="Browse..." Margin="10,0,0,0" Click="BrowseButton_Click"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Info Tab Content -->
            <StackPanel Margin="40" Spacing="20">
                <TextBlock Text="Gorilla Tag Patcher Launcher" FontSize="32" FontWeight="Bold"/>
                <TextBlock Text="Version 1.0.0 (Modern Edition)" FontSize="16" Foreground="#888888"/>
                <TextBlock Text="Based on GTPatcher by GT-Archive-Team" FontSize="14" Foreground="#aaaaaa" Margin="0,-15,0,0"/>

                <Border Background="#252525" Padding="20" CornerRadius="8" BorderBrush="#333333" BorderThickness="1">
                    <TextBlock TextWrapping="Wrap" LineHeight="20">
                        GTPatcher is a community-driven tool for accessing historical builds of Gorilla Tag.
                        <LineBreak/><LineBreak/>
                        • Not affiliated with Another Axiom.
                        <LineBreak/>
                        • Requires a valid Steam account with Gorilla Tag.
                        <LineBreak/>
                        • Please support the official game!
                    </TextBlock>
                </Border>
            </StackPanel>
        </Carousel>
	</Grid>
</Window>
